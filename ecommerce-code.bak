<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Commerce Phase 1</title>
    <!-- <script src="https://cdn.tailwindcss.com"></script> -->
    <link rel="stylesheet" href="css/output.css">
</head>

<body class="bg-gray-50 min-h-screen">

    <nav class="bg-white shadow">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <h1 class="text-2xl font-bold text-blue-600">E-Shop</h1>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="register.html"
                        class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md font-medium">Registrarse</a>
                    <a href="login.html" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Login</a>
                </div>
            </div>
        </div>
    </nav>

    <!--
    <main class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
-->
    <main class="w-full px-6 py-12">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Productos Destacados</h2>
            <p class="mt-4 text-xl text-gray-500">Explora nuestra colección de productos físicos y digitales.</p>
        </div>
        <!--
        <div id="product-list"
            class="grid grid-cols-1 gap-y-10 sm:grid-cols-2 gap-x-6 lg:grid-cols-3 xl:grid-cols-4 xl:gap-x-8">
-->
        <div id="product-list"
            class="grid gap-6 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
            <!-- Productos cargados dinámicamente -->
        </div>
    </main>

    <script src="js/app.js"></script>
</body>

</html>

================ frontend\ordenes.html ================

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Commerce - Mis Órdenes</title>
    <!--    <script src="https://cdn.tailwindcss.com"></script> -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/output.css">
</head>

<body class="bg-gray-100 font-sans">

    <nav id="mainNav" class="bg-white shadow-md"></nav>

    <div class="container mx-auto px-6 py-8">
        <header class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Órdenes</h1>
        </header>

        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="w-full table-auto">
                <thead class="bg-gray-200 text-gray-600 uppercase text-sm leading-normal">
                    <tr>
                        <th class="py-3 px-6 text-left">Orden ID</th>
                        <th class="py-3 px-6 text-left">Fecha</th>
                        <th class="py-3 px-6 text-right">Total</th>
                        <!-- <th class="py-3 px-6 text-center">Acciones</th> -->
                    </tr>
                </thead>
                <tbody id="listaOrdenes" class="text-gray-600 text-sm font-light">
                    <!-- Dynamic Content -->
                </tbody>
            </table>
            <div id="emptyState" class="hidden text-center py-10">
                <p class="text-gray-500 text-lg">No tienes órdenes aún.</p>
                <a href="productos.html" class="text-blue-500 hover:underline mt-2 inline-block">Ir a comprar</a>
            </div>
        </div>
    </div>

    <script type="module" src="js/ordenes.js"></script>
</body>

</html>

