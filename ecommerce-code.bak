================ frontend\productos.html ================

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Commerce - Gestión de Productos</title>
    <link rel="stylesheet" href="css/output.css">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Char counter */
        .char-counter {
            font-size: 0.70rem;
            color: #6b7280;
            text-align: right;
            margin-top: 2px;
        }

        .char-counter.warn {
            color: #ef4444;
            font-weight: 600;
        }

        /* Image manager */
        #imagenesContainer {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .imagen-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            padding: 0.4rem 0.6rem;
        }

        .imagen-item img {
            width: 40px;
            height: 40px;
            object-fit: cover;
            border-radius: 4px;
        }

        .imagen-item input[type="radio"] {
            accent-color: #2563eb;
        }

        .modal-scroll {
            max-height: 80vh;
            overflow-y: auto;
        }
    </style>
</head>

<body class="bg-gray-100 font-sans flex flex-col">

    <!-- Navigation Bar -->
    <nav id="mainNav"></nav>

    <main class="container mx-auto px-6 py-8 flex-grow">

        <header class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Inventario de Productos</h1>
            <button id="btnAgregar"
                class="hidden bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg shadow transition duration-300 flex items-center gap-2">
                <i class="fas fa-plus"></i> Nuevo Producto
            </button>
        </header>

        <!-- Filters -->
        <div class="bg-white p-4 rounded-lg shadow mb-6 flex gap-4 items-center">
            <label class="font-medium text-gray-600">Filtrar por tipo:</label>
            <select id="filtroTipo"
                class="border border-gray-300 rounded px-3 py-1 focus:ring-2 focus:ring-blue-500 outline-none">
                <option value="todos">Todos</option>
                <option value="Fisico">Físico</option>
                <option value="Digital">Digital</option>
            </select>
        </div>

        <!-- Product List Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 text-gray-600 uppercase text-sm leading-normal">
                    <tr>
                        <th class="py-3 px-4">ID</th>
                        <th class="py-3 px-4">Imagen</th>
                        <th class="py-3 px-4">Producto</th>
                        <th class="py-3 px-4">Precio</th>
                        <th class="py-3 px-4">Tipo</th>
                        <th class="py-3 px-4">Proveedor</th>
                        <th class="py-3 px-4 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="listaProductos" class="text-gray-600 text-sm font-light"></tbody>
            </table>
            <!-- Empty State -->
            <div id="emptyState" class="hidden p-8 text-center text-gray-500">
                <i class="fas fa-box-open text-4xl mb-2"></i>
                <p>No hay productos registrados.</p>
            </div>
        </div>

        <!-- ══════════════ MODAL FORM ══════════════ -->
        <div id="modalProducto" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
            <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 overflow-hidden transform transition-all">
                <div class="bg-gray-50 px-6 py-4 border-b flex justify-between items-center">
                    <h3 id="modalTitle" class="text-lg font-semibold text-gray-800">Nuevo Producto</h3>
                    <button id="btnCerrarModal" class="text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <form id="formProducto" class="p-6 space-y-4 modal-scroll">
                    <input type="hidden" id="productoId">

                    <!-- Nombre -->
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="nombre">Nombre <span
                                class="text-red-500">*</span></label>
                        <input type="text" id="nombre" name="nombre"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500"
                            required maxlength="200">
                    </div>

                    <!-- Precio -->
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="precio">Precio <span
                                class="text-red-500">*</span></label>
                        <input type="number" id="precio" name="precio" step="0.01" min="0"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500"
                            required>
                    </div>

                    <!-- Descripción (ADMIN + SUPPLIER) -->
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="descripcion">Descripción (máx 250
                            caracteres)</label>
                        <textarea id="descripcion" name="descripcion" rows="3" maxlength="250"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500 resize-none"
                            placeholder="Máx. 250 caracteres"></textarea>
                        <div class="char-counter" id="contadorDescripcion">0 / 250</div>
                    </div>

                    <!-- Proveedor (ADMIN ONLY) -->
                    <div id="campoProveedor">
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="proveedor">
                            Proveedor <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="proveedor" name="proveedor" maxlength="150"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="Nombre del proveedor o empresa (máx. 150 caracteres)">
                        <div class="char-counter" id="contadorProveedor">0 / 150</div>
                    </div>

                    <!-- Tipo de Producto -->
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="tipo">Tipo de Producto</label>
                        <select id="tipo" name="tipo"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="Fisico">Físico</option>
                            <option value="Digital">Digital</option>
                        </select>
                    </div>

                    <!-- Campos Físicos -->
                    <div id="camposFisico" class="space-y-4">
                        <div>
                            <label class="block text-gray-700 text-sm font-bold mb-1" for="stock">Stock</label>
                            <input type="number" id="stock" name="stock" min="0"
                                class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm font-bold mb-1" for="peso">Peso (kg)</label>
                            <input type="number" id="peso" name="peso" step="0.01" min="0"
                                class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>

                    <!-- Campos Digitales -->
                    <div id="camposDigital" class="hidden space-y-4">
                        <div>
                            <label class="block text-gray-700 text-sm font-bold mb-1" for="urlDescarga">URL
                                Descarga</label>
                            <input type="url" id="urlDescarga" name="urlDescarga"
                                class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>

                    <!-- ── Gestión de Imágenes ── -->
                    <fieldset class="border border-gray-200 rounded-lg p-4">
                        <legend class="text-sm font-bold text-gray-700 px-2">
                            <i class="fas fa-images text-blue-500 mr-1"></i> Imágenes del Producto (mínimo 1)
                            <span class="text-red-500">*</span>
                        </legend>

                        <!-- Lista de imágenes actuales -->
                        <div id="imagenesContainer" class="mb-3"></div>
                        required
                        <p id="sinImagenesMsg" class="text-xs text-gray-400 italic mb-2">Sin imágenes aún.</p>

                        <!-- Agregar nueva imagen -->
                        <div class="flex gap-2 mt-2">
                            <input type="url" id="nuevaImagenUrl"
                                class="flex-1 border rounded px-2 py-1 text-sm outline-none focus:ring-2 focus:ring-blue-400"
                                placeholder="https://ejemplo.com/imagen.jpg">
                            <button type="button" id="btnAgregarImagen"
                                class="bg-blue-100 text-blue-700 hover:bg-blue-200 px-3 py-1 rounded text-sm font-medium transition">
                                <i class="fas fa-plus"></i> Agregar
                            </button>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">Activa el radio "⭐" para marcar la imagen por defecto.</p>
                    </fieldset>

                    <!-- Botones de acción -->
                    <div class="pt-2 flex justify-end gap-3">
                        <button type="button" id="btnCancelar"
                            class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition">Cancelar</button>
                        <button type="submit"
                            class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition shadow">
                            <i class="fas fa-save mr-1"></i>Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </main>

    <script type="module" src="js/productos.js"></script>
</body>

</html>

