<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Commerce - Gestión de Usuarios</title>
    <link rel="stylesheet" href="css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Teléfonos */
        .tel-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: #f3f4f6;
            border-radius: 0.4rem;
            padding: 0.3rem 0.6rem;
            font-size: 0.75rem;
        }

        /* Char counter */
        .char-counter {
            font-size: 0.70rem;
            color: #6b7280;
            text-align: right;
            margin-top: 2px;
        }

        .char-counter.warn {
            color: #ef4444;
            font-weight: 600;
        }

        /* Address card in admin panel */
        .addr-card {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
        }

        .addr-card.preferida {
            border-color: #2563eb;
        }

        .badge-preferida {
            background: #dbeafe;
            color: #1e40af;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 0.1rem 0.5rem;
            border-radius: 9999px;
        }

        /* Modal scroll */
        .modal-body {
            max-height: 80vh;
            overflow-y: auto;
        }

        /* Form grid */
        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }

        @media (min-width: 480px) {
            .form-grid-2 {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>

<body class="bg-gray-100 font-sans flex flex-col min-h-screen">

    <nav id="mainNav" class="space-x-4 flex items-center"></nav>

    <main class="container mx-auto px-6 py-8 flex-grow">

        <header class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Gestión de Usuarios</h1>
            <button id="btnNuevoUsuario"
                class="hidden bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2">
                <i class="fas fa-user-plus"></i> Nuevo Usuario
            </button>
        </header>

        <!-- User Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 text-gray-600 uppercase text-sm leading-normal">
                    <tr>
                        <th class="py-3 px-6">ID</th>
                        <th class="py-3 px-6">Nombre</th>
                        <th class="py-3 px-6">Email</th>
                        <th class="py-3 px-6">Rol</th>
                        <th class="py-3 px-6 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="listaUsuarios" class="text-gray-600 text-sm font-light"></tbody>
            </table>
            <div id="emptyState" class="hidden p-8 text-center text-gray-500">
                <i class="fas fa-users text-4xl mb-2"></i>
                <p>No hay usuarios registrados.</p>
            </div>
        </div>

        <!-- ══════════════ MODAL USUARIO ══════════════ -->
        <div id="modalUsuario" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
            <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b flex justify-between items-center">
                    <h3 id="modalTitle" class="text-lg font-semibold text-gray-800">Nuevo Usuario</h3>
                    <button id="btnCerrarModal" class="text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <form id="formUsuario" class="p-6 space-y-4">
                    <input type="hidden" id="usuarioId">
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="nombre">Nombre</label>
                        <input type="text" id="nombre"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500"
                            required>
                    </div>
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="email">Email</label>
                        <input type="email" id="email"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500"
                            required>
                    </div>
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="password">Contraseña</label>
                        <input type="password" id="password"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="Dejar vacío para mantener la actual">
                        <p class="text-xs text-gray-500 mt-1">Solo requerida al crear nuevo usuario</p>
                    </div>
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="role">Rol</label>
                        <select id="role"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500"
                            required>
                            <option value="">Seleccionar rol...</option>
                            <option value="ADMIN">Administrador</option>
                            <option value="SUPPLIER">Proveedor</option>
                            <option value="CUSTOMER">Cliente</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1" for="fechaNacimiento">Fecha de
                            Nacimiento</label>
                        <input type="date" id="fechaNacimiento"
                            class="w-full border rounded px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div class="pt-4 flex justify-end gap-3">
                        <button type="button" id="btnCancelar"
                            class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition">Cancelar</button>
                        <button type="submit"
                            class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition shadow">Guardar</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ══════════════ MODAL DIRECCIONES (ADMIN) ══════════════ -->
        <div id="modalDirecciones" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b flex justify-between items-center">
                    <h2 id="modalDirTitle" class="text-lg font-semibold text-gray-800">Direcciones del usuario</h2>
                    <button id="btnCerrarDirModal" class="text-gray-400 hover:text-gray-600" aria-label="Cerrar">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body p-6">
                    <!-- Lista de direcciones del usuario seleccionado -->
                    <div class="flex justify-between items-center mb-4">
                        <p class="text-sm text-gray-500">Gestiona las direcciones de este usuario.</p>
                        <button id="btnNuevaDirAdmin"
                            class="bg-blue-600 text-white px-3 py-1.5 rounded-lg text-sm hover:bg-blue-700 transition flex items-center gap-1">
                            <i class="fas fa-plus"></i> Nueva
                        </button>
                    </div>
                    <div id="listaDireccionesAdmin" class="flex flex-col gap-3 mb-4"></div>
                    <div id="emptyDirAdmin" class="hidden text-center py-6 text-gray-400 text-sm">
                        Este usuario no tiene direcciones registradas.
                    </div>

                    <!-- Sub-formulario: Crear / Editar dirección (Admin) -->
                    <div id="formDirAdminWrapper" class="hidden border-t pt-4 mt-2">
                        <h3 id="formDirAdminTitle" class="font-semibold text-gray-700 mb-3">Nueva Dirección</h3>
                        <form id="formDirAdmin" novalidate>
                            <input type="hidden" id="adirId">

                            <div class="flex gap-3 items-end mb-3">
                                <div class="flex-1">
                                    <label for="adirAlias"
                                        class="block text-xs font-medium text-gray-600 mb-1">Alias</label>
                                    <input type="text" id="adirAlias" maxlength="20"
                                        class="w-full border rounded-lg px-2 py-1.5 text-sm outline-none focus:ring-2 focus:ring-blue-400"
                                        placeholder="Casa, Trabajo…">
                                </div>
                                <label class="flex items-center gap-1.5 text-sm cursor-pointer pb-4">
                                    <input type="checkbox" id="adirPreferida" class="accent-blue-600">
                                    Preferida
                                </label>
                            </div>

                            <div class="form-grid-2 mb-3">
                                <div>
                                    <label for="adirCalle" class="block text-xs font-medium text-gray-600 mb-1">Calle
                                        *</label>
                                    <input type="text" id="adirCalle" required maxlength="25"
                                        class="w-full border rounded-lg px-2 py-1.5 text-sm outline-none focus:ring-2 focus:ring-blue-400">
                                </div>
                                <div>
                                    <label for="adirNumExt" class="block text-xs font-medium text-gray-600 mb-1">Núm.
                                        Ext *</label>
                                    <input type="text" id="adirNumExt" required maxlength="10"
                                        class="w-full border rounded-lg px-2 py-1.5 text-sm outline-none focus:ring-2 focus:ring-blue-400">
                                </div>
                                <div>
                                    <label for="adirNumInt" class="block text-xs font-medium text-gray-600 mb-1">Núm.
                                        Int</label>
                                    <input type="text" id="adirNumInt" maxlength="10"
                                        class="w-full border rounded-lg px-2 py-1.5 text-sm outline-none focus:ring-2 focus:ring-blue-400">
                                </div>
                                <div>
                                    <label for="adirRef"
                                        class="block text-xs font-medium text-gray-600 mb-1">Referencia</label>
                                    <input type="text" id="adirRef" maxlength="35"
                                        class="w-full border rounded-lg px-2 py-1.5 text-sm outline-none focus:ring-2 focus:ring-blue-400">
                                </div>
                                <div>
                                    <label for="adirColonia"
                                        class="block text-xs font-medium text-gray-600 mb-1">Colonia *</label>
                                    <input type="text" id="adirColonia" required maxlength="40"
                                        class="w-full border rounded-lg px-2 py-1.5 text-sm outline-none focus:ring-2 focus:ring-blue-400">
                                </div>
                                <div>
                                    <label for="adirMunicipio"
                                        class="block text-xs font-medium text-gray-600 mb-1">Municipio *</label>
                                    <input type="text" id="adirMunicipio" required maxlength="45"
                                        class="w-full border rounded-lg px-2 py-1.5 text-sm outline-none focus:ring-2 focus:ring-blue-400">
                                </div>
                                <div>
                                    <label for="adirEstado" class="block text-xs font-medium text-gray-600 mb-1">Estado
                                        *</label>
                                    <input type="text" id="adirEstado" required maxlength="25"
                                        class="w-full border rounded-lg px-2 py-1.5 text-sm outline-none focus:ring-2 focus:ring-blue-400">
                                </div>
                                <div>
                                    <label for="adirCP" class="block text-xs font-medium text-gray-600 mb-1">C.P. (5
                                        dígs) *</label>
                                    <input type="text" id="adirCP" required pattern="^\d{5}$" maxlength="5"
                                        minlength="5"
                                        class="w-full border rounded-lg px-2 py-1.5 text-sm outline-none focus:ring-2 focus:ring-blue-400"
                                        placeholder="12345">
                                </div>
                            </div>

                            <!-- Teléfonos -->
                            <fieldset class="border border-gray-200 rounded-lg p-3 mb-3">
                                <legend class="text-xs font-semibold text-gray-600 px-1">
                                    <i class="fas fa-phone text-blue-400 mr-1"></i> Teléfonos *
                                </legend>
                                <div id="adirTelContainer" class="flex flex-col gap-1.5 mb-2"></div>
                                <div class="flex gap-2">
                                    <input type="tel" id="adirNuevoTel" maxlength="10" pattern="^\d{10}$"
                                        class="flex-1 border rounded px-2 py-1 text-xs outline-none focus:ring-2 focus:ring-blue-400"
                                        placeholder="10 dígitos">
                                    <button type="button" id="adirBtnAgregarTel"
                                        class="bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs hover:bg-blue-200 transition">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </fieldset>

                            <div class="flex justify-end gap-2">
                                <button type="button" id="btnCancelarDirAdmin"
                                    class="px-3 py-1.5 bg-gray-100 text-gray-700 rounded-lg text-sm hover:bg-gray-200 transition">Cancelar</button>
                                <button type="submit"
                                    class="px-4 py-1.5 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition">
                                    <i class="fas fa-save mr-1"></i> Guardar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <script type="module" src="js/usuarios.js"></script>
</body>

</html>

