          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Proveedor SA\",\n  \"email\": \"proveedor.nuevo@test.com\",\n  \"password\": \"password123\",\n  \"empresa\": \"Tech Supplies SA de CV\",\n  \"fechaNacimiento\": \"2000-01-01\"\n}" },
