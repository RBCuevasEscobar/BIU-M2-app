            ],
            "url": {
              "raw": "{{baseUrl}}/api/ordenes/checkout?direccionId={{direccion_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ordenes",
                "checkout"
              ],
              "query": [
                {
                  "key": "direccionId",
                  "value": "{{direccion_id}}"
                }
              ]
            }
          }
